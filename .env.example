# Browser-visible API origin. Use the deployed backend HTTPS origin on Vercel.
NEXT_PUBLIC_API_URL=http://localhost:5000

# This frontend's canonical origin. Use the same value as the backend BETTER_AUTH_URL.
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=<random-secret-at-least-32-characters>

# Both projects must use the MongoDB database named equiporadb.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/

# Server-only credentials. Configure both values for each provider you use.
GOOGLE_CLIENT_ID=<google-web-client-id>
GOOGLE_CLIENT_SECRET=<google-web-client-secret>
GITHUB_CLIENT_ID=<github-oauth-client-id>
GITHUB_CLIENT_SECRET=<github-oauth-client-secret>
